# =============================================================================
# Perfox Demo Site — Environment Configuration Template
# Copy this file to .env and fill in the values as appropriate
# =============================================================================

# Active Domain Sandbox URLs
VITE_FURNITURE_URL=https://furniture-public-site.vercel.app
VITE_CAR_URL=https://car-enterprises-public-site.vercel.app
VITE_ECOMMERCE_URL=https://e-commerce-public-site.vercel.app
VITE_TAPE_URL=https://aruvi-public-site.vercel.app

# Application Environment
VITE_APP_ENV=development

# -----------------------------------------------------------------------------
# Optional Placeholders for Future Backend & Telemetry Integration
# -----------------------------------------------------------------------------
# Client-side API & Telemetry Keys (VITE_ prefix exposes to browser runtime)
VITE_API_BASE_URL=
VITE_TELEMETRY_API_KEY=
VITE_ANALYTICS_WRITE_KEY=

# Server-side Private Keys (Never exposed to browser bundle)
PERFOX_API_KEY=
PERFOX_SECRET_TOKEN=

